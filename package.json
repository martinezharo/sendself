{
  "name": "sendself",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n worker,web -c blue,green \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:worker": "pnpm --filter @sendself/worker dev",
    "dev:web": "pnpm --filter @sendself/web dev",
    "build": "pnpm --filter @sendself/web build",
    "deploy": "pnpm --filter @sendself/web build && pnpm --filter @sendself/worker run deploy",
    "check:migrations": "node scripts/check-migrations.mts",
    "db:migrate:local": "pnpm --filter @sendself/worker db:migrate:local",
    "db:migrate:remote": "pnpm --filter @sendself/worker db:migrate:remote",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.4",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "workerd", "sharp"],
    "overrides": {
      "brace-expansion@^2.0.0": "2.1.4",
      "brace-expansion@^5.0.0": "5.0.9",
      "fast-uri": "3.1.5",
      "postcss": "8.5.26",
      "undici": "7.29.0"
    }
  }
}
